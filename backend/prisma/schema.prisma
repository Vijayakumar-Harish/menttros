generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  proofComments ProofComment[]
  mentorSkills  MentorSkill[]  @relation("MentorToSkills")
  learnerSkills LearnerSkill[] @relation("LearnerToSkills")

  notifications Notification[]
  auditLogs AuditLog[]
}

model Skill {
  id          String @id @default(uuid())
  name        String
  description String

  mentorSkills  MentorSkill[]  @relation("SkillToMentors")
  learnerSkills LearnerSkill[] @relation("SkillToLearners")
}

enum UserRole {
  LEARNER
  MENTOR
  ADMIN
}

model MentorSkill {
  id       String @id @default(uuid())
  mentorId String
  skillId  String

  mentor User  @relation("MentorToSkills", fields: [mentorId], references: [id])
  skill  Skill @relation("SkillToMentors", fields: [skillId], references: [id])

  @@unique([mentorId, skillId])
}

model LearnerSkill {
  id        String @id @default(uuid())
  learnerId String
  skillId   String
  level     Int    @default(1)

  learner User  @relation("LearnerToSkills", fields: [learnerId], references: [id])
  skill   Skill @relation("SkillToLearners", fields: [skillId], references: [id])

  proofs ProofOfWork[] @relation("LearnerSkillToProofs")

  @@unique([learnerId, skillId])
}

model ProofOfWork {
  id             String      @id @default(uuid())
  learnerSkillId String
  title          String
  description    String
  url            String?
  status         ProofStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?
  comments ProofComment[]
  learnerSkill LearnerSkill @relation("LearnerSkillToProofs", fields: [learnerSkillId], references: [id])
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ProofComment {
  id        String   @id @default(uuid())
  proofId   String
  authorId  String
  message   String
  createdAt DateTime @default(now())

  proof  ProofOfWork @relation(fields: [proofId], references: [id])
  author User        @relation(fields: [authorId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String
  metadata  Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
